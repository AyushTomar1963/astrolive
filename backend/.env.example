# Copy to .env and fill in. Never commit .env.

# Chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Mail (Gmail app password for local / small deploys)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Production mail (required on Render — Gmail SMTP ports are blocked)
RESEND_API_KEY=
RESEND_FROM=AstroLive <onboarding@resend.dev>

# Comma-separated frontend origins (Vercel URL, etc.)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: allow all Vercel preview URLs
# FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# production | unset
NODE_ENV=

# lax for same-site / Vite proxy. none when UI and API are on different sites (Vercel + Render).
COOKIE_SAMESITE=lax

# Auto-created locally if missing; set explicitly in production.
OTP_PEPPER=
TOTP_KEY=
